#include<iostream>
#include<cmath>
using namespace std;
class point{
	private:
		float x;
		float y;
	public:
		point()
		{
			x=0;
			y=0;
		}
		point(float value)
		{
			x=value;
			y=value;
		}
		point(float x, float y)
		{
			this->x=x;
			this->y=y;
		}
		void show()
		{
			cout<<"("<<x<<","<<y<<")"<<endl;
		}
		float dis_from_origin()
		{
		  return (sqrt((x*x)+(y*y)));
		}
		float dis_between(point p)
		{
			return sqrt((p.x-x)*(p.x-x)+(p.y-y)*(p.y-y));
		}
		
};
int main()
{
	point p1;
	point p2(5);
	point p3(2,4);
	
	cout<<"point p1: ";
	p1.show();
	cout<<"point p2: ";
	p2.show();
	cout<<"point p3: ";
	p3.show();
	
	cout<<endl;
	
	cout<<"distance from origin\n";
	cout<<"for point1: "<<p1.dis_from_origin()<<endl;
	cout<<"for point2: "<<p2.dis_from_origin()<<endl;
	cout<<"for point3: "<<p3.dis_from_origin()<<endl;
	
	cout<<endl;
	
	cout<<"dis between point 2 and point 3"<<endl;
	cout<<p2.dis_between(p3)<<endl;
	return 0;
}
